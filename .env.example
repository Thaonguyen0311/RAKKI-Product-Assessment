# Copy this file to .env. Replace every placeholder before starting Docker.
DB_NAME=rakki
DB_USER=rakki_app
DB_PASSWORD=replace_with_a_unique_local_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_unique_local_root_password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
GEMINI_API_KEY=replace_with_your_gemini_api_key_or_leave_blank
GEMINI_MODEL=gemini-3.8-flash
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=5

# Optional locally; production must point to the bundled Azure MySQL CA PEM.
DB_SSL_CA=
STORAGE_PROVIDER=local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=product-images
