GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.8-flash

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rakki
DB_USER=rakki_app
DB_PASSWORD=replace_with_a_unique_local_database_password

APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars

CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=5
STORAGE_DIR=storage

# Optional locally; production must point to the bundled Azure MySQL CA PEM.
DB_SSL_CA=
STORAGE_PROVIDER=local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=product-images
