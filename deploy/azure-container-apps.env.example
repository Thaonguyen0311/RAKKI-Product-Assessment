# Placeholder-only template. Store actual values as Container Apps secrets.
APP_ENV=production
APP_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
CORS_ORIGINS=https://your-project.pages.dev

DB_HOST=mysql-rakki-prod.mysql.database.azure.com
DB_PORT=3306
DB_NAME=rakki
DB_USER=rakki_app
DB_PASSWORD=replace_with_the_existing_application_user_password
DB_SSL_CA=/app/certs/azure-mysql-ca-bundle.pem

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_UPLOAD_SIZE_MB=5

STORAGE_PROVIDER=azure_blob
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=product-images
